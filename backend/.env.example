APP_ENV=development

# ── БАЗА ДАННЫХ ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=neurochat
DB_USER=your_db_user
DB_PASS=your_db_password

# ── APP ───────────────────────────────────────────────────────────────────────
GATEWAY_URL=https://api.example.com/v2/index.php
GATEWAY_API_TOKEN=your_gateway_token
SITE_URL=https://your-domain.com
SUPPORT_LINK=https://telegram.me/neurochat_support
CHANNEL_LINK=https://telegram.me/neurochat_news

# ── GOOGLE OAUTH ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-domain.com/auth/auth.php

# ── TELEGRAM BOT ──────────────────────────────────────────────────────────────
TG_BOT_TOKEN=your_telegram_bot_token
TG_BOT_USERNAME=YourBotUsername
GATEWAY_RESOLVE_IP=92.38.49.67
